{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(python -m py_compile *)",
      "Bash(python -m http.server 8090 *)",
      "Bash(python dev/stack.py *)",
      "Bash(python dev/smoke_api.py *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose -f docker-compose.dev.yml *)",
      "Bash(curl -s*localhost*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git worktree add*)",
      "Bash(git worktree list*)",
      "Bash(git rebase origin/main)",
      "Bash(git branch --show-current)",
      "Bash(git branch -m *)",
      "Bash(git add*)",
      "Bash(git commit -F *)",
      "Bash(git push -u origin *)"
    ],
    "ask": [
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh api*)",
      "Bash(git push*main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(docker compose*down -v*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f *)",
      "Bash(git push -f*)",
      "Bash(git push izsez*)",
      "Bash(git push gitea*)",
      "Bash(git*--no-verify*)",
      "Bash(git*--no-gpg-sign*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh issue close*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f *)",
      "PowerShell(git push izsez*)",
      "PowerShell(git push gitea*)",
      "PowerShell(git*--no-verify*)",
      "PowerShell(git*--no-gpg-sign*)",
      "Read(**/.env)",
      "Read(**/dev/config/**)",
      "Bash(cat*.env*)",
      "Bash(type*.env*)"
    ]
  }
}
